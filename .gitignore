# OSM tile cache
.osm_tiles/

# Python
__pycache__/
*.pyc
.venv/
venv*/
.env

# Outputs
output/
*.log

# Runtime state — MUST NOT be committed.
# These are per-machine artefacts. The GitHub Actions workflow restores both
# via actions/cache, so a committed copy would be restored OVER a warmer one
# and could roll back forecast-vs-observed verification history.
# (An earlier version of production_pipeline.yml asserted "*.db is gitignored"
# — that was not actually true; this section is what makes it true.)
#
# NOTE: only the two volatile files are excluded, NOT the whole directory.
# cache/imd_district_polygons.json is the Maharashtra district boundary geometry
# the choropleth depends on: slow to rebuild and stable, so it stays tracked.
*.db
cache/forecast_cache.json
cache/broadcast_state.json
radar_frames/
_anim_tmp/

# IDE
.vscode/
.idea/
